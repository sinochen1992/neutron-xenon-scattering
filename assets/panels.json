4); c.lineTo(h[0] + 7 * h[1], y0 + 4); c.closePath(); c.fill(); });\n        c.font = \"12px Helvetica, Arial\"; c.textAlign = \"left\"; c.fillText(\"reduced wavelength \" + lam.toFixed(2) + \" fm\" + (lam > 14 ? \" (off scale)\" : \"\"), X(0.2), y0 - 8); },\n      legend: [{label: \"real depth (\" + p.VV.toFixed(1) + \" MeV at centre)\", color: C.om, width: 2.2},\n               {label: \"absorptive depth (volume + surface)\", color: C.wd, width: 2.2}, {label: \"R = \" + F.R.toFixed(2) + \" fm\", color: \"#000\", dash: [7, 3, 2, 3], width: 1}]}, D.plot_limits.potential);\n    var diff=F.difference, scale=+el(\"diff-scale\").value;\n    // Against μ = cos θ (Chen, 2026-10-29): equal widths are equal solid angle; forward scattering at the left.\n    var baseLimits=D.plot_limits.difference || {xlim:[1,-1],ylim:[-0.25,0.25]};\n    var diffLimits={xlim:baseLimits.xlim,ylim:scale>0?[-scale,scale]:baseLimits.ylim};\n    var MUd = Array.prototype.slice.call(COS);\n    var diffSeries=[{x:[1,-1],y:[0,0],color:\"#999\",width:1}], diffLegend=[];\n    if(diff.available) {\n      diffSeries.push({x:MUd,y:diff.values,color:\"#7b3294\",width:2});\n      diffSeries.push({x:[1,-1],y:[diff.constant,diff.constant],color:\"#222\",dash:[7,4]});\n      diffLegend=[{label:\"ENDF/B-VII.1 − JENDL-4.0u\",color:\"#7b3294\"},\n                  {label:\"constant Δσ_el / (4π)\",color:\"#222\",dash:[7,4]}];\n      var clipped=Math.min(diff.minimum,diff.constant)<diffLimits.ylim[0] || Math.max(diff.maximum,diff.constant)>diffLimits.ylim[1];\n      el(\"diff-info\").textContent=\"ENDF − JENDL · \"+opts[+tg.value][0]+\" · \"+t.toPrecision(5)+\" MeV: Δσ_el = \"+diff.delta_el.toPrecision(5)+\n        \" b; C = \"+diff.constant.toPrecision(5)+\" b/sr; full-angle range [\"+diff.minimum.toPrecision(5)+\", \"+diff.maximum.toPrecision(5)+\n        \"] b/sr; solid-angle RMS about C = \"+diff.rms.toPrecision(5)+\" b/sr.\"+\n        (clipped?\" Curve/reference extends outside this y range; choose a wider Difference y range.\":\"\");\n    } else el(\"diff-info\").textContent=\"ENDF − JENDL unavailable: \"+diff.reason;\n    var thetaTicks=[0,30,60,90,120,150,180].map(function(d){return [Math.cos(d*Math.PI/180), String(d)];});\n    plot(CTX.diff,{title:\"ENDF − JENDL: is the difference constant?\",xlabel:\"μ = cos θ (CM); forward scattering at the left\",\n      ylabel:\"Δ(dσ/dΩ) [b/sr]\",xstep:0.25,ylog:false,series:diffSeries,legend:diffLegend,legendRows:2,\n      top:{label:\"θ [deg]\",ticks:thetaTicks}},diffLimits);\n    present();\n  }\n  var pending = false;\n  function request() { if (!pending) { pending = true; window.requestAnimationFrame(function () { pending = false; draw(); }); } }\n  el(\"T\").addEventListener(\"input\", function () { exactT = null; request(); });\n  el(\"diff-scale\").addEventListener(\"change\",request);\n  [\"c\"].forEach(function (id) { el(id).addEventListener(\"input\", request); });\n  [\"tg\", \"bl\", \"hs\"].forEach(function (id) { el(id).addEventListener(\"change\", request); });\n  draw();\n})();\n</script>\n","optman":"\n<div id=\"ROOT\" style=\"font:13px Arial,sans-serif;color:#222;background:white;max-width:1240px;padding:6px\">\n <div style=\"display:flex;flex-wrap:wrap;gap:15px;align-items:center\">\n  <label>Xe-132 energy <select id=\"ROOT-energy\"><option value=\"2.45\">DD 2.45 MeV</option><option value=\"14.1\">D–T 14.1 MeV</option></select></label>\n  <label>OPTMAN input <select id=\"ROOT-model\"><option value=\"kunieda_cc\">Kunieda coupled-channel demo</option><option value=\"kd_spherical\">KD spherical cross-check</option></select></label>\n  <label title=\"Compound elastic of Xe-132 from the TALYS calculation (KD potential); the slider moves only within its range\">compound elastic, within the calculated range: lower <input id=\"ROOT-f\" type=\"range\" min=\"0\" max=\"1\" step=\"0.01\" value=\"1\" style=\"vertical-align:middle;width:120px\"> upper <span id=\"ROOT-value\"></span></label>\n </div>\n <div style=\"display:flex;flex-wrap:wrap\"><svg id=\"ROOT-angular\" viewBox=\"0 0 600 410\" style=\"width:600px;max-width:100%\"></svg><svg id=\"ROOT-recoil\" viewBox=\"0 0 600 410\" style=\"width:600px;max-width:100%\"></svg></div>\n <div id=\"ROOT-info\" style=\"line-height:1.5;margin-top:5px\"></div>\n <p><b>Curves:</b> blue solid is the shape elastic of the selected input; orange dashed adds compound elastic; orange dotted is compound elastic alone; grey dotted is the project's spherical KD calculation for comparison. Compound elastic comes from a Hauser–Feshbach (TALYS) calculation with the spherical KD potential, with its calculated angular shape; the slider moves only within that calculation's range with a width-fluctuation correction. With the coupled-channel input it is an approximation: that calculation's own statistical part (POD in the JENDL chain) is not available here.</p>\n <p>OPTMAN calculates direct excitation of the coupled levels explicitly; the compound elastic is taken out of the remaining absorption, so the total stays fixed. At 14.1 MeV compound elastic is negligible. These plots show elastic recoils only.</p>\n <p>Our Xe-132 inputs use A = 132 amu and nonrelativistic kinematics. The coupled-channel demo uses the Kunieda global coefficients, β₂ = 0.1409, and 0⁺, 2⁺ (0.66772 MeV), 4⁺ (1.44033 MeV) levels. It is not a reproduction of the JENDL evaluator's calculation. Only the two computed energies are selectable.</p>\n <p>Figures generated for this notebook from IAEA OPTMAN, our documented inputs, and the selected evaluated libraries. Sources: <a href=\"https://github.com/IAEA-NDS/OPTMAN/tree/48e94f360552fe43ae1764225d8dd601ca9c51a1\">OPTMAN source</a>; <a href=\"https://doi.org/10.1080/18811248.2007.9711321\">Kunieda et al. (2007)</a>; <a href=\"https://github.com/IAEA-NDS/RIPL-4\">IAEA RIPL</a>.</p>\n</div>\n<script>\n(function(){\n'use strict';\nconst D=__DATA__,NS='http://www.w3.org/2000/svg';\nconst el=s=>document.getElementById('ROOT-'+s), colors=['#0072b2','#e66101','#e66101','#777'];\nfunction interp(x,xs,ys){const n=xs.length;if(x<=xs[0])return ys[0];if(x>=xs[n-1])return ys[n-1];\n let lo=0,hi=n-1;while(hi-lo>1){const m=(lo+hi)>>1;if(xs[m]<=x)lo=m;else hi=m;}return ys[lo]+(x-xs[lo])/(xs[hi]-xs[lo])*(ys[hi]-ys[lo]);}\nfunction frame(energy,model,f){\n if(!Number.isFinite(f)||f<0||f>1)throw Error('Invalid position in the compound-elastic range');\n const r=D.rows[energy+'/'+model];if(!r)throw Error('Uncomputed energy/model');\n const c=r.talys,compound=c.lo+f*(c.hi-c.lo);\n const compoundAngular=D.angles.map(a=>compound/(4*Math.PI)*interp(a,c.theta,c.shape));\n const compoundRecoil=r.er.map(e=>compound/r.endpoint*interp(Math.acos(Math.min(1,Math.max(-1,1-2*e/r.endpoint)))*180/Math.PI,c.theta,c.shape));\n return {row:r,compound:compound,elastic:r.shape+compound,nonelastic:r.direct+r.absorption-compound,\n  compoundAngular:compoundAngular,compoundRecoil:compoundRecoil,\n  angular:r.dsdo.map((y,i)=>y+compoundAngular[i]),recoil:r.dsde.map((y,i)=>y+compoundRecoil[i])};\n}\nfunction path(xs,ys,xmax,ymin,ymax){\n const y0=Math.log10(ymin),dy=Math.log10(ymax)-y0;\n return xs.map((x,i)=>((i?'L':'M')+(64+524*x/xmax).toFixed(3)+','+\n  (362-252*(Math.log10(Math.max(ys[i],ymin*1e-4))-y0)/dy).toFixed(3))).join(' ');\n}\nif(typeof globalThis!=='undefined'&&globalThis.__OPTMAN_TEST__){globalThis.__OPTMAN_API__={frame:frame,path:path,data:D};return;}\nfunction node(tag,attributes,text,parent){const n=document.createElementNS(NS,tag);Object.keys(attributes).forEach(k=>n.setAttribute(k,attributes[k]));if(text!==undefined)n.textContent=text;if(parent)parent.appendChild(n);return n;}\nfunction label(svg,x,y,text,extra){return node('text',Object.assign({x:x,y:y,'font-size':11,'text-anchor':'middle',fill:'#222'},extra||{}),text,svg);}\nconst plots={};\n['angular','recoil'].forEach(function(kind){\n const svg=el(kind),isAngle=kind==='angular',ymin=isAngle?.001:.000001,ymax=isAngle?20:1000;\n label(svg,325,18,isAngle?'Xe-132 elastic angular distribution':'Xe-132 single elastic recoil',{'font-size':14,'font-weight':'bold'});\n const defs=node('defs',{},undefined,svg),clip=node('clipPath',{id:'ROOT-clip-'+kind},undefined,defs);\n node('rect',{x:64,y:110,width:524,height:252},undefined,clip);\n for(let e=Math.ceil(Math.log10(ymin));e<=Math.floor(Math.log10(ymax));e++){\n  const y=362-252*(e-Math.log10(ymin))/(Math.log10(ymax)-Math.log10(ymin));\n  node('line',{x1:64,x2:588,y1:y,y2:y,stroke:'#ddd'},undefined,svg);label(svg,59,y+4,'10^'+e,{'text-anchor':'end'});\n }\n const xticks=[];for(let i=0;i<=6;i++){const x=64+524*i/6;node('line',{x1:x,x2:x,y1:110,y2:362,stroke:'#eee'},undefined,svg);xticks.push(label(svg,x,379,''));}\n node('rect',{x:64,y:110,width:524,height:252,stroke:'#333',fill:'none'},undefined,svg);\n label(svg,325,402,isAngle?'CM scattering angle [degrees]':'Nuclear recoil energy [keV]');\n label(svg,15,236,isAngle?'dσ/dΩ [b/sr]':'dσ/dEᵣ [b/keV]',{transform:'rotate(-90 15 236)'});\n const group=node('g',{'clip-path':'url(#ROOT-clip-'+kind+')'},undefined,svg);\n const endpoint=node('line',{y1:110,y2:362,stroke:'#333','stroke-dasharray':'6 3 1 3'},undefined,group);\n const labels=['shape elastic (selected input)','shape + compound elastic','compound elastic alone (TALYS)','shape elastic, spherical KD (comparison)'];\n const example=D.rows['2.45/kunieda_cc'];example.libraries.forEach(l=>labels.push(l.label+' (all elastic)'));\n const curveColors=colors.concat(example.libraries.map(l=>l.color)),curves=[];\n const cols=labels.length>6?3:2;\n labels.forEach((name,i)=>{const x=66+(i%cols)*524/cols,y=40+Math.floor(i/cols)*18,dash=i===1?'7 4':i===2?'2 3':i===3?'3 3':'';\n  node('line',{x1:x,x2:x+17,y1:y,y2:y,stroke:curveColors[i],'stroke-width':2,'stroke-dasharray':dash},undefined,svg);\n  label(svg,x+22,y+3,name,{'text-anchor':'start','font-size':9});\n  curves.push(node('path',{fill:'none',stroke:curveColors[i],'stroke-width':i<2?2.2:1.3,'stroke-dasharray':dash},undefined,group));\n });\n plots[kind]={curves:curves,ticks:xticks,endpoint:endpoint,ymin:ymin,ymax:ymax};\n});\nfunction draw(){\n const energy=el('energy').value,model=el('model').value,f=+el('f').value,F=frame(energy,model,f),r=F.row;\n ['angular','recoil'].forEach(kind=>{\n  const a=kind==='angular',p=plots[kind],xs=a?D.angles:r.er,xmax=a?180:1.15*r.endpoint;\n  const arrays=[a?r.dsdo:r.dsde,a?F.angular:F.recoil,\n   F.compound>0?(a?F.compoundAngular:F.compoundRecoil):null,a?r.base.dsdo:r.base.dsde];\n  r.libraries.forEach(l=>arrays.push(l.available?(a?l.dsdo:l.dsde):null));\n  arrays.forEach((ys,i)=>{p.curves[i].setAttribute('d',ys?path(xs,ys,xmax,p.ymin,p.ymax):'');});\n  p.ticks.forEach((n,i)=>n.textContent=(i*xmax/6).toPrecision(3).replace(/\\.0+$/,''));\n  p.endpoint.setAttribute('visibility',a?'hidden':'visible');\n  p.endpoint.setAttribute('x1',64+524/1.15);p.endpoint.setAttribute('x2',64+524/1.15);\n });\n el('value').textContent=F.compound.toFixed(4)+' b';\n const b=v=>v.toFixed(4)+' b';\n el('info').innerHTML='<b>'+D.models[model]+', Xe-132, '+energy+' MeV</b><br>Calculated: shape elastic '+b(r.shape)+' + direct inelastic '+b(r.direct)+' + absorption '+b(r.absorption)+' = total '+b(r.total)+\n '<br>Compound elastic (TALYS, KD potential): '+b(F.compound)+', range '+b(r.talys.lo)+'–'+b(r.talys.hi)+' with a width-fluctuation correction ('+(r.absorption>0?(F.compound/r.absorption).toFixed(3):'0')+' of this input\\'s absorption). Elastic = '+b(r.shape)+' + '+b(F.compound)+' = <b>'+b(F.elastic)+'</b>; non-elastic = '+b(F.nonelastic)+'; total stays '+b(r.total)+\n '<br>E_max (Xe-132) = '+r.endpoint.toFixed(2)+' keV; recoil x-range = 0–1.15 E_max. All y-ranges stay fixed.'+\n (r.levels.length?'<br>Calculated direct excitation: 2⁺ '+b(r.levels[0])+'; 4⁺ '+b(r.levels[1])+'.':'')+\n r.libraries.map(l=>'<br>'+l.label+': '+(l.available?'all elastic '+b(l.elastic_b)+'; total '+b(l.total_b):l.reason)).join('');\n}\nlet pending=false;function request(){if(pending)return;pending=true;requestAnimationFrame(()=>{pending=false;draw();});}\nel('f').addEventListener('input',request);el('energy').addEventListener('change',request);el('model').addEventListener('change',request);draw();\n})();\n</script>\n"}
